<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ASnapdo</AssemblyName>
    <RootNamespace>ASnapdo</RootNamespace>
    <Company>AAStudio.kr</Company>
    <Product>ASnapdo</Product>
    <Version>1.0.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets/ASnapdo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/ASnapdo.ico" />
    <EmbeddedResource Include="../../LICENSE.txt" LogicalName="ASnapdo.License.txt" />
  </ItemGroup>
</Project>
